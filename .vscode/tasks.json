{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test ml",
      "type": "shell",
      "command": "../.venv/bin/python -m pytest -q",
      "windows": { "command": "..\\.venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/ml" },
      "problemMatcher": []
    },
    {
      "label": "test backend",
      "type": "shell",
      "command": "../.venv/bin/python -m pytest -q",
      "windows": { "command": "..\\.venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "test frontend",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "test all",
      "dependsOn": ["test ml", "test backend", "test frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "run backend",
      "type": "shell",
      "command": "../.venv/bin/python -m uvicorn app.main:factory --factory --reload --port 8000",
      "windows": { "command": "..\\.venv\\Scripts\\python -m uvicorn app.main:factory --factory --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": "build frontend",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegin": true, "beginsPattern": "Will watch for changes", "endsPattern": "Application startup complete" }
      }
    }
  ]
}
