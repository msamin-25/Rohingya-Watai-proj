{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["ml/tests", "backend/tests"],
  "python.analysis.extraPaths": ["ml", "backend"],
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, ".venv.nosync": true },
  "search.exclude": { "**/node_modules": true, "frontend/dist": true, ".venv.nosync": true },
  "files.watcherExclude": { "**/.venv.nosync/**": true, "**/node_modules/**": true }
}
