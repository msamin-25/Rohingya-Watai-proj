# Copy to .env with:  python scripts/make_env.py   (fills in fresh random values)
# .env is git-ignored. Never commit it.

# Helper key for teaching, tests, deleting and exporting recordings (32+ random characters).
RVB_ADMIN_TOKEN=change-me

# Where private recordings are stored. Keep this OUT of folders that sync to the cloud
# (iCloud Desktop/Documents, OneDrive, Dropbox). make_env.py picks a safe local folder per OS.
RVB_DATA_DIR=var

# Hosts the server answers to (protects against DNS rebinding). Keep it local.
RVB_ALLOWED_HOSTS=localhost,127.0.0.1

# Largest accepted upload in bytes (about 60 s of 16 kHz audio).
RVB_MAX_UPLOAD_BYTES=2000000
